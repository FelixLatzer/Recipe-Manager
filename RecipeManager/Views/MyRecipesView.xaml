<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModel="clr-namespace:RecipeManager.ViewModels"
             xmlns:model="clr-namespace:RecipeManager.Models"
             x:Class="RecipeManager.Views.MyRecipesView"
             x:DataType="viewModel:MyRecipeViewModel"
             Title="My Recipes">
    <ScrollView>
        <VerticalStackLayout>
            <Label 
                Text="Your recipes"
                VerticalOptions="Center" 
                HorizontalOptions="Center"
                FontSize="Title"
                Margin="10"/>

            <CollectionView ItemsSource="{Binding Recipes}">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:Recipe">
                        <SwipeView>
                            <SwipeView.LeftItems>
                                <SwipeItems>
                                    <SwipeItem Text="Delete"
                                               BackgroundColor="Red"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type viewModel:MyRecipeViewModel}}, Path=DeleteRecipeCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.LeftItems>

                            <!-- Add a tap gesture recognizer to handle navigation -->
                            <Frame BorderColor="Gray" Margin="5" Padding="10">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModel:MyRecipeViewModel}}, Path=OpenRecipeCommand}"
                                        CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <Grid>
                                    <Label Text="{Binding Name}" 
                                           VerticalOptions="Center" 
                                           FontSize="Medium"/>
                                </Grid>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
